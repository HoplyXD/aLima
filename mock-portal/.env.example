# Mock Portal configuration.
# Copy this file to .env and fill in real values at runtime.
# Never commit .env.

PORT=3001
FACT_CARDS_PATH=./data/fact_cards.json
MUSEUM_RECORDS_PATH=./data/museum_records.json
DATABASE_PATH=./cache/portal.db

# Optional API-key auth. When set, the backend must send
# Authorization: Bearer <PORTAL_API_KEY>.
# Leave blank to allow unauthenticated requests (default for local dev).
PORTAL_API_KEY=
PORTAL_REQUIRE_API_KEY=false
